# Dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
/20-10fe/test-results/
/20-10fe/playwright-report/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.production

# Logs and runtime files
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
*.swp
*.swo

# Accidental npm metadata at repository root (no root package.json)
/package-lock.json

# Local Cloudflare binary (install separately or keep outside Git)
/cloudflared.exe

# Keep one canonical shared-data snapshot; ignore local recovery exports
/20-10be/backups/*.sql
!/20-10be/backups/current-data.sql
