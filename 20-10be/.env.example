# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL — local hoặc cloud (Aiven/TiDB/Azure...)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=gift_20_10

# TLS: bắt buộc khi dùng MySQL cloud, để trống/false khi chạy MySQL local.
# DB_SSL_CA là đường dẫn tới ca.pem tải từ console nhà cung cấp (khuyến nghị);
# bỏ trống thì vẫn mã hóa nhưng không xác thực chứng chỉ máy chủ.
DB_SSL=false
DB_SSL_CA=

# Cloudinary (dùng chung 1 account giữa các máy để quản lý ảnh đúng)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin (dùng cho bootstrap, mỗi máy tự đặt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# Gemini AI greeting (tùy chọn — nếu bỏ trống sẽ dùng lời chúc tĩnh)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Face ID (tùy chọn) — địa chỉ face-service Python chạy nội bộ trên máy này.
# Bỏ trống hoặc xóa dòng thì mặc định http://127.0.0.1:5002 vẫn dùng được;
# service không chạy thì thẻ Face ID tự ẩn, web vẫn hoạt động bình thường.
FACE_SERVICE_URL=http://127.0.0.1:5002
# Ngưỡng nhận diện lấy từ face-service/RESULTS.md; chỉ đổi khi đã đo lại.
# FACE_TAU=0.45
# FACE_MARGIN=0.10
