# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=gift_20_10

# Cloudinary (dùng chung 1 account giữa các máy để quản lý ảnh đúng)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin (dùng cho bootstrap, mỗi máy tự đặt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# Gemini AI greeting (tùy chọn — nếu bỏ trống sẽ dùng lời chúc tĩnh)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
